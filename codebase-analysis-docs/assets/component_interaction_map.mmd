flowchart LR
    subgraph Frontend_Components ["Frontend UI Components (React)"]
        Index["Index.tsx<br/>Landing Page"]
        Nav["Navigation.tsx<br/>Header & Anchor Nav"]
        Chat["ChatInterface.tsx<br/>Message Feed & State"]
        Foot["Footer.tsx<br/>Links & Disclaimers"]
        UI_Lib["@/components/ui/*<br/>Shadcn / Radix Primitives"]

        Index --> Nav
        Index --> Chat
        Index --> Foot
        Chat --> UI_Lib
    end

    subgraph Frontend_Services ["Frontend Services Layer"]
        ApiService["ApiService (api.ts)<br/>Type-safe Fetch Client"]
        Chat --> ApiService
    end

    subgraph Backend_Controller ["Backend Controllers & Routing (FastAPI)"]
        Main["main.py<br/>FastAPI Application"]
        HealthEndpoint["/api/health"]
        StatsEndpoint["/api/stats"]
        ChatEndpoint["/api/chat"]
        SearchEndpoint["/api/search"]
        BuildDbEndpoint["/api/build-db"]
        DocEndpoint["/api/doc/{doc_id}"]

        ApiService -->|POST /api/chat| ChatEndpoint
        ApiService -.->|GET /api/health| HealthEndpoint
        ApiService -.->|GET /api/stats| StatsEndpoint
        ApiService -.->|GET /api/search (Method Mismatch)| SearchEndpoint
        ApiService -.->|POST /api/build-db| BuildDbEndpoint
        ApiService -.->|GET /api/doc/{id}| DocEndpoint

        Main --> HealthEndpoint
        Main --> StatsEndpoint
        Main --> ChatEndpoint
        Main --> SearchEndpoint
        Main --> BuildDbEndpoint
        Main --> DocEndpoint
    end

    subgraph Backend_Core ["Backend Core Engines"]
        RAGPipeline["RAGPipeline (rag_pipeline.py)<br/>Prompt Builder & Orchestrator"]
        VectorDB["VectorDatabase (vector_database.py)<br/>ChromaDB Manager & Embeddings"]

        ChatEndpoint --> RAGPipeline
        RAGPipeline --> VectorDB
        SearchEndpoint --> VectorDB
        BuildDbEndpoint --> VectorDB
        DocEndpoint --> VectorDB
    end

    subgraph External_Services ["External Runtimes & Datastores"]
        ChromaStore[("ChromaDB<br/>Persistent Storage")]
        OllamaEngine["Ollama Server (:11434)<br/>qwen3:8b Engine"]
        HuggingFaceHub["HuggingFace Hub<br/>viber1/indian-law-dataset"]

        VectorDB --> ChromaStore
        RAGPipeline --> OllamaEngine
    end

    subgraph ETL_Scripts ["ETL & Pipeline Scripts"]
        DtLoader["dt.py<br/>IndianLawDatasetLoader"]
        HuggingFaceHub --> DtLoader
        DtLoader --> RawData[("legal_data_all.json")]
        RawData -.-> BuildDbEndpoint
        RawData -.-> VectorDB
    end

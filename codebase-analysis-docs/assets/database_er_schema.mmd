erDiagram
    RAW_JSON_ITEM {
        int id PK "Sequential integer index"
        string Instruction "Legal query or situation"
        string Response "Canonical legal answer"
    }

    CHROMADB_RECORD {
        string id PK "qa_{id} unique identifier"
        string document "Combined Question and Answer text"
        float_array embedding "384-dimensional dense vector"
        json metadata "Metadata JSON payload"
    }

    CHROMADB_METADATA {
        string id "Raw dataset ID as string"
        string instruction "Truncated Instruction (first 500 chars)"
        string response "Truncated Response (first 500 chars)"
        string instruction_length "Stringified int of full instruction length"
        string response_length "Stringified int of full response length"
    }

    CONVERSATION_SESSION {
        string conversation_id PK "UUIDv4 session token"
        list messages "FIFO list capped at 10 message dicts"
    }

    CONVERSATION_MESSAGE {
        string role "user or assistant"
        string content "Message text content"
    }

    API_CHAT_RESPONSE_SOURCE {
        string title "Fallback to 'Unknown'"
        string source "Fallback to 'Unknown'"
        string category "Fallback to 'Unknown'"
        string url "Empty string by default"
        string preview "First 200 chars of document"
    }

    RAW_JSON_ITEM ||--|| CHROMADB_RECORD : "ingested into"
    CHROMADB_RECORD ||--|| CHROMADB_METADATA : "persists"
    CHROMADB_RECORD ||--o{ API_CHAT_RESPONSE_SOURCE : "mapped into"
    CONVERSATION_SESSION ||--o{ CONVERSATION_MESSAGE : "contains"
